ENVIRONMENT=production
AUTH_MODE=oidc
DATABASE_URL=postgresql+psycopg://movewise:replace-in-deployment@db:5432/movewise
SESSION_SECRET=replace-with-a-long-random-value-from-secret-manager
CORS_ORIGINS=https://app.example.invalid
FRONTEND_URL=https://app.example.invalid
PUBLIC_API_URL=https://api.example.invalid
OIDC_METADATA_URL=https://identity.example.invalid/.well-known/openid-configuration
OIDC_CLIENT_ID=replace-in-deployment
OIDC_CLIENT_SECRET=replace-in-deployment
OIDC_ISSUER=https://identity.example.invalid/
PRIVATE_UPLOAD_DIR=/var/lib/movewise/uploads
MAX_UPLOAD_BYTES=10485760
MAX_WORKSPACE_UPLOAD_BYTES=104857600
AI_REQUESTS_PER_MINUTE=20
UPLOADS_PER_HOUR=10
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=replace-in-deployment
